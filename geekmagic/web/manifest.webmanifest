{
  "name": "Экран GeekMagic",
  "short_name": "GeekMagic",
  "description": "Картинки, GIF и текст на экран GeekMagic SmallTV Ultra",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#121214",
  "theme_color": "#121214",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "file", "accept": ["image/*", ".gif", ".jpg", ".jpeg", ".png", ".webp"] }]
    }
  }
}
